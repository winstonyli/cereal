>> fix-all of fixit/main.c: 3 edits, equal to cereal fix
#include <stdio.h>
#define NEG(x) -(x)
int f(int a, int b)
{
    if (a = b)
        return 1;
    return puts("x") + NEG(b);
}
int g();
int g(void) { return 0; }
