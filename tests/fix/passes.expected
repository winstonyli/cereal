diff -ruN snap/p.c t/p.c
--- snap/p.c
+++ t/p.c
@@ -1,2 +1,2 @@
 struct S { int x; };
-int f(struct S *p, struct S *q) { return p.x + q.x; }
+int f(struct S *p, struct S *q) { return p->x + q.x; }
$ cereal fix p.c
exit 0
