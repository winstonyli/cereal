/* diag_opts.def - every configurable diagnostic: DIAG_OPT(ID, name, group, level, on, by, help).
 * Included by diag.h (the DiagOpt enum) and diag.c (the registry); the row for DW_ID is
 * options[DW_ID - 1].  Hard errors use DW_NONE and are not listed. */
/* preprocessor core */
DIAG_OPT(PP_WARNING_DIRECTIVE, "pp-warning-directive", "pp", DL_WARNING, true, 0, "#warning directive")
DIAG_OPT(C99_C11_COMPAT, "c99-c11-compat", "c", DL_WARNING, true, 0, "C11 features in C99 mode (pedantic pedwarns)")
DIAG_OPT(C11_C2X_COMPAT, "c11-c2x-compat", "c", DL_WARNING, true, 0, "C2X features in C11 and earlier modes (pedantic pedwarns)")
DIAG_OPT(DEPRECATED, "deprecated", "pp", DL_WARNING, true, 0, "GCC assertions (#assert, #unassert, #pred(answer) in #if)")
DIAG_OPT(UNDEF, "undef", "cond", DL_WARNING, false, 0, "undefined identifier evaluates to 0 in #if")
DIAG_OPT(MACRO_REDEFINED, "macro-redefined", "pp", DL_WARNING, true, 0, "non-identical macro redefinition (C99 6.10.3p2)")
DIAG_OPT(BUILTIN_MACRO_REDEFINED, "builtin-macro-redefined", "pp", DL_WARNING, true, 0, "redefining or undefining a predefined macro")
DIAG_OPT(UNKNOWN_PRAGMAS, "unknown-pragmas", "pp", DL_WARNING, false, DO_ALL | DO_EXTRA, "unrecognized #pragma")
DIAG_OPT(INVALID_PP_TOKEN, "invalid-pp-token", "pp", DL_WARNING, true, 0, "unterminated character or string literal")
DIAG_OPT(SUGGEST_ATTRIBUTE_VFORMAT, "suggest-attribute=format", "c", DL_WARNING, false, 0, "a function calling a v*printf/v*scanf-like function with its own format might take the format attribute (-Wmissing-format-attribute)")
DIAG_OPT(LARGER_THAN_V, "larger-than=", "c", DL_WARNING, true, 0, "object larger than N bytes (N: a size, kB/MB.. units)")
DIAG_OPT(BIDI_CHARS_V, "bidi-chars=", "pp", DL_WARNING, true, 0, "bidirectional control characters in comments, literals and identifiers")
DIAG_OPT(NORMALIZED_V, "normalized=", "pp", DL_WARNING, true, 0, "identifier not in Unicode NFC (or NFKC)")
DIAG_OPT(DIRECTIVE_IN_MACRO_ARGS, "directive-in-macro-args", "pp", DL_WARNING, true, 0, "directive inside macro arguments (C99 6.10.3p11 UB)")
DIAG_OPT(TRIGRAPHS, "trigraphs", "pp", DL_WARNING, true, DO_ALL, "trigraphs: ignored (GNU modes) or, when asked for, converted")
DIAG_OPT(ENDIF_LABELS, "endif-labels", "pp", DL_WARNING, true, 0, "extra tokens after #else or #endif")
DIAG_OPT(EXTRA_TOKENS, "extra-tokens", "pp", DL_WARNING, true, 0, "extra tokens at end of directive")
DIAG_OPT(SIGN_PROMO_IN_IF, "sign-promo-in-if", "pp", DL_WARNING, false, DO_ALL, "#if operand that changes sign when promoted (untagged in gcc)")
DIAG_OPT(VARIADIC_MACROS, "variadic-macros", "pp", DL_WARNING, true, 0, "named variadic macros under -pedantic")
DIAG_OPT(INCLUDE_NEXT_IN_PRIMARY, "include-next-in-primary", "pp", DL_WARNING, true, 0, "#include_next in primary source file")
DIAG_OPT(EXPANSION_TO_DEFINED, "expansion-to-defined", "cond", DL_WARNING, true, 0, "macro expansion produced 'defined' in #if (UB)")
DIAG_OPT(INTEGER_OVERFLOW_IN_IF, "integer-overflow-in-if", "cond", DL_WARNING, true, 0, "signed overflow in #if expression")
DIAG_OPT(PEDANTIC, "pedantic", "pedantic", DL_WARNING, false, 0, "GNU extensions and non-portable constructs")
DIAG_OPT(STDC_PRAGMA, "stdc-pragma", "pp", DL_WARNING, true, 0, "malformed STDC pragma")
/* hygiene */
DIAG_OPT(MACRO_UNPARENTHESIZED_PARAM, "macro-unparenthesized-param", "hygiene", DL_WARNING, true, 0, "parameter used as an operand without parentheses")
DIAG_OPT(MACRO_UNPARENTHESIZED_BODY, "macro-unparenthesized-body", "hygiene", DL_WARNING, true, 0, "expression-like body without enclosing parentheses")
DIAG_OPT(MACRO_MULTI_STATEMENT, "macro-multi-statement", "hygiene", DL_WARNING, true, 0, "statement-like body not wrapped in do { } while (0)")
DIAG_OPT(MACRO_DANGLING_ELSE, "macro-dangling-else", "hygiene", DL_WARNING, true, 0, "body is an if-statement without else (dangling else hazard)")
DIAG_OPT(MACRO_TRAILING_SEMICOLON, "macro-trailing-semicolon", "hygiene", DL_WARNING, true, 0, "body ends with ';'")
DIAG_OPT(MACRO_MULTI_EVAL, "macro-multi-eval", "hygiene", DL_WARNING, true, 0, "argument with side effects evaluated more than once")
DIAG_OPT(MACRO_MULTI_EVAL_CALL, "macro-multi-eval-call", "hygiene", DL_WARNING, false, DO_ALL | DO_EXTRA, "argument containing a call evaluated more than once")
DIAG_OPT(MACRO_DISCARDED_SIDE_EFFECT, "macro-discarded-side-effect", "hygiene", DL_WARNING, true, 0, "argument with side effects never evaluated")
DIAG_OPT(MACRO_RESERVED_NAME, "macro-reserved-name", "hygiene", DL_WARNING, true, 0, "macro name is a reserved identifier or keyword")
DIAG_OPT(MACRO_UNUSED_PARAM, "macro-unused-param", "hygiene", DL_REMARK, false, 0, "parameter never used in the body")
DIAG_OPT(MACRO_UNBALANCED, "macro-unbalanced", "hygiene", DL_REMARK, false, 0, "unbalanced delimiters in the body")
DIAG_OPT(MACRO_SELF_REFERENCE, "macro-self-reference", "hygiene", DL_REMARK, false, 0, "macro refers to itself (not re-expanded)")
DIAG_OPT(MACRO_RECURSION, "macro-recursion", "hygiene", DL_REMARK, false, 0, "macros refer to each other in a cycle (not re-expanded)")
/* conditional compilation */
DIAG_OPT(COND_DEAD_BRANCH, "cond-dead-branch", "cond", DL_WARNING, true, 0, "branch can never be taken in any configuration")
DIAG_OPT(COND_REDUNDANT, "cond-redundant", "cond", DL_WARNING, true, 0, "condition is always true given enclosing conditions")
DIAG_OPT(COND_CONSTANT, "cond-constant", "cond", DL_REMARK, false, 0, "#if condition is a constant (e.g. #if 0)")
DIAG_OPT(COND_TYPO, "cond-typo", "cond", DL_WARNING, true, 0, "tested macro is never defined but a similar name is")
DIAG_OPT(COND_NEVER_DEFINED, "cond-never-defined", "cond", DL_REMARK, false, 0, "tested macro is never defined anywhere")
DIAG_OPT(ENDIF_LABEL, "endif-label", "cond", DL_WARNING, true, 0, "#endif/#else comment does not match the opening condition")
/* include / dependency */
DIAG_OPT(HEADER_GUARD, "header-guard", "include", DL_WARNING, true, 0, "include guard #ifndef and #define disagree")
DIAG_OPT(MISSING_HEADER_GUARD, "missing-header-guard", "include", DL_WARNING, true, 0, "header has no include guard or #pragma once")
DIAG_OPT(GUARD_COLLISION, "guard-collision", "include", DL_WARNING, true, 0, "two headers use the same include guard macro")
DIAG_OPT(DUPLICATE_INCLUDE, "duplicate-include", "include", DL_WARNING, true, 0, "same header included twice from one file")
DIAG_OPT(INCLUDE_CYCLE, "include-cycle", "include", DL_REMARK, false, 0, "include cycle")
DIAG_OPT(UNUSED_INCLUDE, "unused-include", "include", DL_WARNING, true, 0, "macro-only header provides nothing used")
DIAG_OPT(UNUSED_MACROS, "unused-macros", "include", DL_WARNING, true, 0, "macro defined in the main file is never used")
/* C: gcc 13 names and defaults under -std=c99 */
DIAG_OPT(IMPLICIT_INT, "implicit-int", "c", DL_WARNING, true, DO_IMPLICIT, "declaration without a type specifier defaults to int")
DIAG_OPT(IMPLICIT_FUNCTION_DECLARATION, "implicit-function-declaration", "c", DL_WARNING, true, DO_IMPLICIT, "call of an undeclared function")
DIAG_OPT(MULTICHAR, "multichar", "c", DL_WARNING, true, 0, "multi-character character constant")
DIAG_OPT(OVERFLOW, "overflow", "c", DL_WARNING, true, 0, "constant expression overflows or conversion changes a constant")
DIAG_OPT(DIV_BY_ZERO, "div-by-zero", "c", DL_WARNING, true, 0, "integer division by zero in a constant")
DIAG_OPT(INT_CONVERSION, "int-conversion", "c", DL_WARNING, true, 0, "implicit conversion between integer and pointer")
DIAG_OPT(INCOMPATIBLE_POINTER_TYPES, "incompatible-pointer-types", "c", DL_WARNING, true, 0, "conversion between incompatible pointer types")
DIAG_OPT(DISCARDED_QUALIFIERS, "discarded-qualifiers", "c", DL_WARNING, true, 0, "conversion discards qualifiers from pointer target type")
DIAG_OPT(DISCARDED_ARRAY_QUALIFIERS, "discarded-array-qualifiers", "c", DL_WARNING, true, 0, "conversion discards qualifiers of array elements")
DIAG_OPT(SCALAR_STORAGE_ORDER, "scalar-storage-order", "c", DL_WARNING, true, 0, "reverse scalar storage order mismatch")
DIAG_OPT(INT_TO_POINTER_CAST, "int-to-pointer-cast", "c", DL_WARNING, true, 0, "cast to pointer from integer of different size")
DIAG_OPT(POINTER_TO_INT_CAST, "pointer-to-int-cast", "c", DL_WARNING, true, 0, "cast from pointer to integer of different size")
DIAG_OPT(BUILTIN_DECLARATION_MISMATCH, "builtin-declaration-mismatch", "c", DL_WARNING, true, 0, "declaration of a builtin function with the wrong type")
DIAG_OPT(RETURN_LOCAL_ADDR, "return-local-addr", "c", DL_WARNING, true, 0, "function returns the address of a local variable")
DIAG_OPT(SHIFT_COUNT_NEGATIVE, "shift-count-negative", "c", DL_WARNING, true, 0, "shift count is negative")
DIAG_OPT(SHIFT_COUNT_OVERFLOW, "shift-count-overflow", "c", DL_WARNING, true, 0, "shift count >= width of type")
DIAG_OPT(STRICT_ALIASING_V, "strict-aliasing=", "c", DL_WARNING, false, DO_ALL, "dereferencing a pointer that breaks type-based aliasing (level 2: casts, 3: dereferences)")
DIAG_OPT(SHIFT_OVERFLOW_V, "shift-overflow=", "c", DL_WARNING, true, 0, "left shift overflows (level 1: signed, 2: also into the sign bit)")
DIAG_OPT(POINTER_COMPARE, "pointer-compare", "c", DL_WARNING, true, 0, "comparison of a pointer with a zero character constant")
DIAG_OPT(SWITCH_BOOL, "switch-bool", "c", DL_WARNING, true, 0, "switch on a boolean expression")
DIAG_OPT(SWITCH_OUTSIDE_RANGE, "switch-outside-range", "c", DL_WARNING, true, 0, "case value outside the range of the controlling type")
DIAG_OPT(OVERRIDE_INIT_SIDE_EFFECTS, "override-init-side-effects", "c", DL_WARNING, true, 0, "initialized field with side effects overwritten")
DIAG_OPT(DESIGNATED_INIT, "designated-init", "c", DL_WARNING, true, 0, "positional initializer for a designated_init struct")
DIAG_OPT(ATTRIBUTES, "attributes", "c", DL_WARNING, true, 0, "unknown or misplaced attribute")
DIAG_OPT(IGNORED_ATTRIBUTES, "ignored-attributes", "c", DL_WARNING, true, 0, "attribute ignored")
DIAG_OPT(DEPRECATED_DECLARATIONS, "deprecated-declarations", "c", DL_WARNING, true, 0, "use of a deprecated declaration")
DIAG_OPT(ADDRESS_OF_PACKED_MEMBER, "address-of-packed-member", "c", DL_WARNING, true, 0, "address of a packed member may be unaligned")
DIAG_OPT(PACKED_BITFIELD_COMPAT, "packed-bitfield-compat", "c", DL_WARNING, true, 0, "packed bit-field layout changed in GCC 4.4")
DIAG_OPT(IF_NOT_ALIGNED, "if-not-aligned", "c", DL_WARNING, true, 0, "warn_if_not_aligned type is under-aligned")
DIAG_OPT(UNUSED_RESULT, "unused-result", "c", DL_WARNING, true, 0, "result of a warn_unused_result function ignored")
DIAG_OPT(NONNULL, "nonnull", "c", DL_WARNING, true, 0, "null passed to a nonnull parameter")
DIAG_OPT(VARARGS, "varargs", "c", DL_WARNING, true, 0, "questionable use of va_start")
DIAG_OPT(SIZEOF_ARRAY_ARGUMENT, "sizeof-array-argument", "c", DL_WARNING, true, 0, "sizeof on an array parameter")
DIAG_OPT(XOR_USED_AS_POW, "xor-used-as-pow", "c", DL_WARNING, true, 0, "2 ^ N or 10 ^ N probably meant as a power")
DIAG_OPT(RETURN_TYPE, "return-type", "c", DL_WARNING, false, DO_ALL, "return with(out) a value, or falling off a non-void function")
DIAG_OPT(MAIN, "main", "c", DL_WARNING, false, DO_ALL | DO_PEDANTIC, "suspicious declaration of main")
DIAG_OPT(POINTER_SIGN, "pointer-sign", "c", DL_WARNING, false, DO_ALL | DO_PEDANTIC, "pointer targets differ in signedness")
DIAG_OPT(PARENTHESES, "parentheses", "c", DL_WARNING, false, DO_ALL, "parentheses suggested")
DIAG_OPT(DANGLING_ELSE, "dangling-else", "c", DL_WARNING, false, DO_ALL, "ambiguous else")
DIAG_OPT(SWITCH, "switch", "c", DL_WARNING, false, DO_ALL, "enumeration value not handled in switch, or case not in enum")
DIAG_OPT(CHAR_SUBSCRIPTS, "char-subscripts", "c", DL_WARNING, false, DO_ALL, "array subscript has type char")
DIAG_OPT(MISSING_BRACES, "missing-braces", "c", DL_WARNING, false, DO_ALL, "missing braces around an initializer")
DIAG_OPT(SEQUENCE_POINT, "sequence-point", "c", DL_WARNING, false, DO_ALL, "operation on an object may be undefined")
DIAG_OPT(DUPLICATE_DECL_SPECIFIER, "duplicate-decl-specifier", "c", DL_WARNING, false, DO_ALL, "duplicate type qualifier")
DIAG_OPT(ENUM_COMPARE, "enum-compare", "c", DL_WARNING, false, DO_ALL, "comparison between different enumeration types")
DIAG_OPT(ENUM_INT_MISMATCH, "enum-int-mismatch", "c", DL_WARNING, false, DO_ALL, "redeclaration mixes an enumerated type and an integer type")
DIAG_OPT(ADDRESS, "address", "c", DL_WARNING, false, DO_ALL, "suspicious use of an address (always true, string comparison)")
DIAG_OPT(BOOL_COMPARE, "bool-compare", "c", DL_WARNING, false, DO_ALL, "boolean compared with a non-boolean constant")
DIAG_OPT(BOOL_OPERATION, "bool-operation", "c", DL_WARNING, false, DO_ALL, "suspicious operation on a boolean")
DIAG_OPT(LOGICAL_NOT_PARENTHESES, "logical-not-parentheses", "c", DL_WARNING, false, DO_ALL, "logical not on the left of a comparison")
DIAG_OPT(TAUTOLOGICAL_COMPARE, "tautological-compare", "c", DL_WARNING, false, DO_ALL, "comparison always evaluates to true or false")
DIAG_OPT(MISLEADING_INDENTATION, "misleading-indentation", "c", DL_WARNING, false, DO_ALL, "indentation does not reflect the block structure")
DIAG_OPT(DUPLICATED_BRANCHES, "duplicated-branches", "c", DL_WARNING, false, 0, "if or ?: with identical branches")
DIAG_OPT(DUPLICATED_COND, "duplicated-cond", "c", DL_WARNING, false, 0, "repeated condition in an if / else-if chain")
DIAG_OPT(LOGICAL_OP, "logical-op", "c", DL_WARNING, false, 0, "suspicious uses of logical operators (equal or exclusive tests, non-boolean constant)")
DIAG_OPT(MULTISTATEMENT_MACROS, "multistatement-macros", "c", DL_WARNING, false, DO_ALL, "macro expands to multiple statements guarded by one clause")
DIAG_OPT(MEMSET_TRANSPOSED_ARGS, "memset-transposed-args", "c", DL_WARNING, false, DO_ALL, "memset with a constant zero length")
DIAG_OPT(MEMSET_ELT_SIZE, "memset-elt-size", "c", DL_WARNING, false, DO_ALL, "memset length equal to the number of elements")
DIAG_OPT(UNSUFFIXED_FLOAT_CONSTANTS, "unsuffixed-float-constants", "c", DL_WARNING, false, 0, "floating constant without a suffix")
DIAG_OPT(DATE_TIME, "date-time", "c", DL_WARNING, false, 0, "use of __DATE__, __TIME__ or __TIMESTAMP__")
DIAG_OPT(INT_IN_BOOL_CONTEXT, "int-in-bool-context", "c", DL_WARNING, false, DO_ALL, "suspicious integer expression in a boolean context")
DIAG_OPT(ARRAY_COMPARE, "array-compare", "c", DL_WARNING, false, DO_ALL, "comparison of two arrays")
DIAG_OPT(ARRAY_PARAMETER_V, "array-parameter=", "c", DL_WARNING, false, DO_ALL, "array parameter redeclared with a different bound")
DIAG_OPT(ARRAY_BOUNDS_V, "array-bounds=", "c", DL_WARNING, false, DO_ALL, "constant array index out of bounds")
DIAG_OPT(C90_C99_COMPAT, "c90-c99-compat", "c", DL_WARNING, false, 0, "C99 features that C90 lacks")
DIAG_OPT(DOUBLE_PROMOTION, "double-promotion", "c", DL_WARNING, false, 0, "implicit conversion of float to double or long double")
DIAG_OPT(STRINGOP_OVERREAD, "stringop-overread", "c", DL_WARNING, true, 0, "string function reading past the end of its argument")
DIAG_OPT(VLA_PARAMETER, "vla-parameter", "c", DL_WARNING, false, DO_ALL, "VLA parameter redeclared with a different bound")
DIAG_OPT(SIZEOF_POINTER_DIV, "sizeof-pointer-div", "c", DL_WARNING, false, DO_ALL, "sizeof (pointer) / sizeof (element)")
DIAG_OPT(SIZEOF_POINTER_MEMACCESS, "sizeof-pointer-memaccess", "c", DL_WARNING, false, DO_ALL, "sizeof of a pointer as the size of a memory access")
DIAG_OPT(SIZEOF_ARRAY_DIV, "sizeof-array-div", "c", DL_WARNING, false, DO_ALL, "sizeof (array) / sizeof (wrong type)")
DIAG_OPT(NONNULL_COMPARE, "nonnull-compare", "c", DL_WARNING, false, DO_ALL, "nonnull parameter compared with null")
DIAG_OPT(RESTRICT, "restrict", "c", DL_WARNING, false, DO_ALL, "overlapping arguments to restrict parameters")
DIAG_OPT(ZERO_LENGTH_BOUNDS, "zero-length-bounds", "c", DL_WARNING, false, DO_ALL, "access of a zero-length array member")
DIAG_OPT(PACKED_NOT_ALIGNED, "packed-not-aligned", "c", DL_WARNING, false, DO_ALL, "packed struct member under-aligned")
DIAG_OPT(VOLATILE_REGISTER_VAR, "volatile-register-var", "c", DL_WARNING, false, DO_ALL, "register variable declared volatile")
DIAG_OPT(UNUSED_VARIABLE, "unused-variable", "c", DL_WARNING, false, DO_UNUSED, "unused local or static variable")
DIAG_OPT(UNUSED_FUNCTION, "unused-function", "c", DL_WARNING, false, DO_UNUSED, "static function declared but not defined or used")
DIAG_OPT(UNUSED_LABEL, "unused-label", "c", DL_WARNING, false, DO_UNUSED, "label defined but not used")
DIAG_OPT(UNUSED_VALUE, "unused-value", "c", DL_WARNING, false, DO_UNUSED, "statement with no effect, value computed not used")
DIAG_OPT(UNUSED_BUT_SET_VARIABLE, "unused-but-set-variable", "c", DL_WARNING, false, DO_UNUSED, "variable set but not used")
DIAG_OPT(UNUSED_LOCAL_TYPEDEFS, "unused-local-typedefs", "c", DL_WARNING, false, DO_UNUSED, "locally defined typedef not used")
DIAG_OPT(UNUSED_PARAMETER, "unused-parameter", "c", DL_WARNING, false, DO_UNUSED_EXTRA, "unused function parameter")
DIAG_OPT(UNUSED_BUT_SET_PARAMETER, "unused-but-set-parameter", "c", DL_WARNING, false, DO_UNUSED_EXTRA, "parameter set but not used")
DIAG_OPT(IGNORED_QUALIFIERS, "ignored-qualifiers", "c", DL_WARNING, false, DO_EXTRA, "type qualifiers ignored (e.g. on a return type)")
DIAG_OPT(OLD_STYLE_DECLARATION, "old-style-declaration", "c", DL_WARNING, false, DO_EXTRA, "storage class not at the beginning of a declaration")
DIAG_OPT(WRITE_STRINGS, "write-strings", "c", DL_WARNING, false, 0, "string literals have type const char[]")
DIAG_OPT(TRADITIONAL, "traditional", "c", DL_WARNING, false, 0, "constructs with different meaning in traditional C")
DIAG_OPT(TRADITIONAL_CONVERSION, "traditional-conversion", "c", DL_WARNING, false, 0, "conversion of an argument that a prototype changes")
DIAG_OPT(MISSING_FIELD_INITIALIZERS, "missing-field-initializers", "c", DL_WARNING, false, DO_EXTRA, "struct initializer leaves fields uninitialized")
DIAG_OPT(MISSING_PARAMETER_TYPE, "missing-parameter-type", "c", DL_WARNING, false, DO_EXTRA, "K&R parameter without a type")
DIAG_OPT(OVERRIDE_INIT, "override-init", "c", DL_WARNING, false, DO_EXTRA, "initialized field overwritten")
DIAG_OPT(EMPTY_BODY, "empty-body", "c", DL_WARNING, false, DO_EXTRA, "empty body of an if, else or do while")
DIAG_OPT(SIGN_COMPARE, "sign-compare", "c", DL_WARNING, false, DO_EXTRA, "comparison between signed and unsigned")
DIAG_OPT(TYPE_LIMITS, "type-limits", "c", DL_WARNING, false, DO_EXTRA, "comparison always true or false due to the range of a type")
DIAG_OPT(SHIFT_NEGATIVE_VALUE, "shift-negative-value", "c", DL_WARNING, false, DO_EXTRA, "left shift of a negative value")
DIAG_OPT(ENUM_CONVERSION, "enum-conversion", "c", DL_WARNING, false, DO_EXTRA, "implicit conversion between enumerated types")
DIAG_OPT(CAST_FUNCTION_TYPE, "cast-function-type", "c", DL_WARNING, false, DO_EXTRA, "cast between incompatible function types")
DIAG_OPT(POINTER_ARITH, "pointer-arith", "c", DL_WARNING, false, DO_PEDANTIC, "sizeof (void), arithmetic on void * or function pointers")
DIAG_OPT(OVERLENGTH_STRINGS, "overlength-strings", "c", DL_WARNING, false, DO_PEDANTIC, "string longer than the C99 minimum (4095)")
DIAG_OPT(OLD_STYLE_DEFINITION, "old-style-definition", "c", DL_WARNING, false, 0, "K&R function definition")
DIAG_OPT(MISSING_PROTOTYPES, "missing-prototypes", "c", DL_WARNING, false, 0, "global function defined without a prototype")
DIAG_OPT(MISSING_DECLARATIONS, "missing-declarations", "c", DL_WARNING, false, 0, "global function defined without a previous declaration")
DIAG_OPT(STRICT_PROTOTYPES, "strict-prototypes", "c", DL_WARNING, false, 0, "function declared without parameter types")
DIAG_OPT(SHADOW, "shadow", "c", DL_WARNING, false, 0, "declaration shadows another")
DIAG_OPT(SHADOW_VLOCAL, "shadow=local", "c", DL_WARNING, false, 0, "declaration shadows a parameter or local")
DIAG_OPT(SHADOW_VCOMPATIBLE_LOCAL, "shadow=compatible-local", "c", DL_WARNING, false, 0, "declaration shadows a parameter or local of a compatible type")
DIAG_OPT(REDUNDANT_DECLS, "redundant-decls", "c", DL_WARNING, false, 0, "redundant redeclaration in the same scope")
DIAG_OPT(NESTED_EXTERNS, "nested-externs", "c", DL_WARNING, false, 0, "extern declaration inside a function")
DIAG_OPT(PRAGMAS, "pragmas", "pp", DL_WARNING, true, 0, "malformed or misused pragma")
DIAG_OPT(CPP_COMPAT, "c++-compat", "c", DL_WARNING, false, 0, "constructs with different meaning or validity in C++")
DIAG_OPT(PRIO_CTOR_DTOR, "prio-ctor-dtor", "c", DL_WARNING, true, 0, "constructor/destructor priority reserved for the implementation")
DIAG_OPT(ABSOLUTE_VALUE, "absolute-value", "c", DL_WARNING, false, DO_EXTRA, "abs/fabs/cabs called with an argument of the wrong kind")
DIAG_OPT(BAD_FUNCTION_CAST, "bad-function-cast", "c", DL_WARNING, false, 0, "cast of a call to a non-matching type")
DIAG_OPT(CAST_QUAL, "cast-qual", "c", DL_WARNING, false, 0, "cast removes a qualifier from the target type")
DIAG_OPT(CAST_ALIGN_V, "cast-align=", "c", DL_WARNING, false, 0, "cast increases the required alignment (strict only: a no-op where unaligned access works)")
DIAG_OPT(CONVERSION, "conversion", "c", DL_WARNING, false, 0, "implicit conversion that may change a value")
DIAG_OPT(SIGN_CONVERSION, "sign-conversion", "c", DL_WARNING, false, 0, "implicit conversion that may change the sign")
DIAG_OPT(ARITH_CONVERSION, "arith-conversion", "c", DL_WARNING, false, 0, "conversion of an arithmetic result may change its value")
DIAG_OPT(FORMAT_V, "format=", "c", DL_WARNING, true, 0, "printf-style conversion that does not match its argument")
DIAG_OPT(FORMAT_EXTRA_ARGS, "format-extra-args", "c", DL_WARNING, true, 0, "more arguments than the format uses")
DIAG_OPT(FORMAT_ZERO_LENGTH, "format-zero-length", "c", DL_WARNING, true, 0, "empty format string")
DIAG_OPT(FORMAT_CONTAINS_NUL, "format-contains-nul", "c", DL_WARNING, true, 0, "format string with an embedded NUL")
DIAG_OPT(FORMAT_SECURITY, "format-security", "c", DL_WARNING, true, 0, "format string that is not a literal and has no arguments")
DIAG_OPT(FORMAT_NONLITERAL, "format-nonliteral", "c", DL_WARNING, false, 0, "format string that is not a literal")
DIAG_OPT(FORMAT_SIGNEDNESS, "format-signedness", "c", DL_WARNING, false, 0, "format conversions that differ in signedness")
DIAG_OPT(FLOAT_CONVERSION, "float-conversion", "c", DL_WARNING, false, 0, "implicit conversion that reduces floating precision")
DIAG_OPT(FLOAT_EQUAL, "float-equal", "c", DL_WARNING, false, 0, "floating-point values compared for equality")
DIAG_OPT(JUMP_MISSES_INIT, "jump-misses-init", "c", DL_WARNING, false, 0, "goto or switch jumps over a variable initialization")
DIAG_OPT(SWITCH_DEFAULT, "switch-default", "c", DL_WARNING, false, 0, "switch without a default case")
DIAG_OPT(SWITCH_ENUM, "switch-enum", "c", DL_WARNING, false, 0, "enumeration value not handled in switch (even with default)")
DIAG_OPT(DECLARATION_AFTER_STATEMENT, "declaration-after-statement", "c", DL_WARNING, false, 0, "declaration after a statement in a block")
