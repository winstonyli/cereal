/* attrs.def - one row per attribute name: ATTR(name, ID, flags, ctx, argc_lo, argc_hi).
 * Included by attrs.h (the AttrId enum) and cattr.c (the AttrDesc array); the row for AT_X is
 * attr_tab[AT_X - 1] (AT_NONE = 0 and AT_UNKNOWN are not rows).  Rows are sorted by strcmp in the C
 * locale (attr_lookup bisects them; bench/tools/attr_lists.sh checks it).  Names are spelled without their __ affixes.
 * flags: AF_KNOWN __has_attribute and __builtin_has_attribute (gcc 13 on x86-64), AF_STD a C2X
 *   standard attribute, AF_FN_ONLY needs a function type, AF_EXPR_ARGS arguments are
 *   expressions, AF_COPY_EXCL not copied by attribute copy.
 * ctx: the AC_* declaration contexts in which the attribute is ignored on a non-function
 *   (AC_E: on an enumerator; AC_FN: on a function instead); 0 never.  argc_lo/hi: the argument count gcc accepts. */
ATTR(_Noreturn, AT_NORETURN2, AF_STD, 0, 0, AT_ARGC_ANY)
ATTR(access, AT_ACCESS, AF_KNOWN|AF_FN_ONLY, 0, 1, 3)
ATTR(alias, AT_ALIAS, AF_KNOWN|AF_COPY_EXCL, AC_E, 0, AT_ARGC_ANY)
ATTR(aligned, AT_ALIGNED, AF_KNOWN|AF_EXPR_ARGS, 0, 0, AT_ARGC_ANY)
