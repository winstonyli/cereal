(set-logic QF_BV)
(declare-const r (_ BitVec 32))(declare-const c (_ BitVec 32))(declare-const i (_ BitVec 32))(declare-const j (_ BitVec 32))(declare-const len (_ BitVec 64))
(define-fun sx ((x (_ BitVec 32))) (_ BitVec 64) ((_ sign_extend 32) x))
(assert (and (bvsle #x00000000 r) (bvsle #x00000000 c)
  (bvule (bvmul (sx r) (sx c)) len)
  (bvsle (bvmul (sx r) (sx c)) #x000000007fffffff)
  (bvsle #x00000000 i) (bvslt i r) (bvsle #x00000000 j) (bvslt j c)))
(assert (not (bvult (sx (bvadd (bvmul i c) j)) len)))
(check-sat)
